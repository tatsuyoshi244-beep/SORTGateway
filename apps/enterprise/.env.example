# SORT Gateway v2.1 Enterprise — 環境変数
# コピー: cp .env.example .env.local

# --- Supabase（公開キーはクライアント可）---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase（サーバーのみ・絶対にクライアントに露出しない）---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI（サーバーのみ・本番推奨）---
OPENAI_API_KEY=sk-your-openai-key
# 任意: OPENAI_MODEL=gpt-4o-mini

# --- 本番必須（Vercel Cron / 手動ジョブ）---
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- 外部連携資格情報の暗号化（本番推奨）---
# INTEGRATION_CREDENTIALS_KEY=32-byte-hex-key

# --- ビルド表示（任意）---
# NEXT_PUBLIC_APP_VERSION=0.1.0
# BUILD_SHA=
# BUILD_TIME=

# --- RAG / ドキュメント（任意・ローカル開発）---
# EMBEDDING_PROVIDER=dummy
# DOCUMENT_UPLOAD_DIR=.data/uploads
