{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "training-manual-ai-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "training-manual-ai-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "./migrations"
  }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "training-manual-ai-local-docs" }],
  "vars": { "COMPANY_NAME": "研修デモ会社", "INITIAL_ADMIN_EMAIL": "owner@example.test", "INITIAL_ADMIN_NAME": "テスト管理者", "ALLOWED_EMAIL_DOMAIN": "example.test" }
}
