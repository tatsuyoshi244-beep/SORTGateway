{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "training-manual-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "training-manual-ai",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "training-manual-ai-docs"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "COMPANY_NAME": "研修テスト会社",
    "INITIAL_ADMIN_EMAIL": "owner@example.invalid",
    "INITIAL_ADMIN_NAME": "初期管理者",
    "ALLOWED_EMAIL_DOMAIN": "example.invalid"
  }
}
